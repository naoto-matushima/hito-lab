# DB接続文字列（PostgreSQL）。ローカル開発ではローカルDBまたはPreview用DBを指す
DATABASE_URL=

# メール送信サービスのAPIキー（Report DL通知等）
EMAIL_API_KEY=

# アクセス解析（GA4）の測定ID。クライアント側で読むためNEXT_PUBLIC_必須。未設定時は計測しない
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Object Storage（Report PDF等のAsset保管）のアクセストークン
BLOB_TOKEN=

# サイトのベースURL（canonical/OGP/構造化データ生成用）。ドメイン確定前の開発時はlocalhostのままでよい
NEXT_PUBLIC_SITE_URL=http://localhost:3000
